{
  "openapi": "3.1.0",
  "info": {
    "title": "QA Demo Store API",
    "description": "REST API for the QA Demo Store (v3). Mirror of the PHP/MySQL backend for preview/dev.\n\n**Authentication:** Call `POST /api/auth/login` to obtain a Bearer token (64 hex chars, 24h TTL). Send it on protected routes as `Authorization: Bearer <token>`.\n\n",
    "version": "3.0.0"
  },
  "paths": {
    "/api/": {
      "get": {
        "tags": [
          "Public"
        ],
        "summary": "API root",
        "operationId": "root_api__get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RootResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/products": {
      "get": {
        "tags": [
          "Public"
        ],
        "summary": "List all products or get one by id",
        "description": "Omit `id` to list the catalog. Pass `id` to fetch a single product.",
        "operationId": "list_products_api_products_get",
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Product id; omit to list all",
              "title": "Id"
            },
            "description": "Product id; omit to list all"
          }
        ],
        "responses": {
          "200": {
            "description": "Product list (no `id`) or single product (`id` set)",
            "content": {
              "application/json": {
                "schema": {},
                "examples": {
                  "list": {
                    "summary": "All products",
                    "value": {
                      "products": [
                        {
                          "id": 1,
                          "name": "Sauce Labs Backpack",
                          "price": 29.99
                        }
                      ]
                    }
                  },
                  "single": {
                    "summary": "One product",
                    "value": {
                      "product": {
                        "id": 1,
                        "name": "Sauce Labs Backpack",
                        "price": 29.99
                      }
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Product not found"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Login",
        "description": "Exchange username and password for a Bearer token (24-hour TTL).",
        "operationId": "auth_login_api_auth_login_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponse"
                }
              }
            }
          },
          "401": {
            "description": "Invalid credentials"
          },
          "403": {
            "description": "Account locked"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/signup": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Sign up",
        "description": "Create a new user account.",
        "operationId": "signup_api_signup_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SignupRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SignupResponse"
                }
              }
            }
          },
          "400": {
            "description": "Validation error or username/email already taken"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/profile": {
      "get": {
        "tags": [
          "Protected"
        ],
        "summary": "Current user profile",
        "operationId": "profile_api_profile_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProfileResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid, or expired token"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/api/orders": {
      "get": {
        "tags": [
          "Protected"
        ],
        "summary": "List orders",
        "description": "Returns orders for the authenticated user. Pass `user_id` to filter by another user.",
        "operationId": "list_orders_api_orders_get",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "user_id",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filter by user id; defaults to caller",
              "title": "User Id"
            },
            "description": "Filter by user id; defaults to caller"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrdersListResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid, or expired token"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Protected"
        ],
        "summary": "Create order",
        "description": "Order total is always recomputed server-side from current product prices.",
        "operationId": "create_order_api_orders_post",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OrderRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateOrderResponse"
                }
              }
            }
          },
          "400": {
            "description": "Validation error, empty cart, or unknown product id"
          },
          "401": {
            "description": "Missing, invalid, or expired token"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CreateOrderResponse": {
        "properties": {
          "success": {
            "type": "boolean",
            "title": "Success"
          },
          "order_id": {
            "type": "integer",
            "title": "Order Id"
          },
          "total": {
            "type": "number",
            "title": "Total"
          }
        },
        "type": "object",
        "required": [
          "success",
          "order_id",
          "total"
        ],
        "title": "CreateOrderResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "LoginRequest": {
        "properties": {
          "username": {
            "type": "string",
            "title": "Username",
            "examples": [
              "standard_user"
            ]
          },
          "password": {
            "type": "string",
            "title": "Password",
            "examples": [
              "secret_sauce"
            ]
          }
        },
        "type": "object",
        "required": [
          "username",
          "password"
        ],
        "title": "LoginRequest"
      },
      "LoginResponse": {
        "properties": {
          "token": {
            "type": "string",
            "title": "Token"
          },
          "expires_at": {
            "type": "string",
            "title": "Expires At"
          },
          "user": {
            "$ref": "#/components/schemas/UserPublic"
          }
        },
        "type": "object",
        "required": [
          "token",
          "expires_at",
          "user"
        ],
        "title": "LoginResponse"
      },
      "OrderItemIn": {
        "properties": {
          "product_id": {
            "type": "integer",
            "title": "Product Id"
          },
          "quantity": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Quantity"
          }
        },
        "type": "object",
        "required": [
          "product_id",
          "quantity"
        ],
        "title": "OrderItemIn"
      },
      "OrderItemOut": {
        "properties": {
          "product_id": {
            "type": "integer",
            "title": "Product Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "price": {
            "type": "number",
            "title": "Price"
          },
          "quantity": {
            "type": "integer",
            "title": "Quantity"
          }
        },
        "type": "object",
        "required": [
          "product_id",
          "name",
          "price",
          "quantity"
        ],
        "title": "OrderItemOut"
      },
      "OrderOut": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "user_id": {
            "type": "integer",
            "title": "User Id"
          },
          "full_name": {
            "type": "string",
            "title": "Full Name"
          },
          "address": {
            "type": "string",
            "title": "Address"
          },
          "city": {
            "type": "string",
            "title": "City"
          },
          "state": {
            "type": "string",
            "title": "State"
          },
          "pincode": {
            "type": "string",
            "title": "Pincode"
          },
          "phone": {
            "type": "string",
            "title": "Phone"
          },
          "total": {
            "type": "number",
            "title": "Total"
          },
          "created_at": {
            "type": "string",
            "title": "Created At"
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/OrderItemOut"
            },
            "type": "array",
            "title": "Items"
          }
        },
        "type": "object",
        "required": [
          "id",
          "user_id",
          "full_name",
          "address",
          "city",
          "state",
          "pincode",
          "phone",
          "total",
          "created_at",
          "items"
        ],
        "title": "OrderOut"
      },
      "OrderRequest": {
        "properties": {
          "full_name": {
            "type": "string",
            "maxLength": 120,
            "minLength": 2,
            "title": "Full Name"
          },
          "address": {
            "type": "string",
            "maxLength": 255,
            "minLength": 2,
            "title": "Address"
          },
          "city": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "City"
          },
          "state": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "State"
          },
          "pincode": {
            "type": "string",
            "maxLength": 20,
            "minLength": 3,
            "title": "Pincode"
          },
          "phone": {
            "type": "string",
            "title": "Phone"
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/OrderItemIn"
            },
            "type": "array",
            "title": "Items"
          }
        },
        "type": "object",
        "required": [
          "full_name",
          "address",
          "city",
          "state",
          "pincode",
          "phone",
          "items"
        ],
        "title": "OrderRequest"
      },
      "OrdersListResponse": {
        "properties": {
          "orders": {
            "items": {
              "$ref": "#/components/schemas/OrderOut"
            },
            "type": "array",
            "title": "Orders"
          }
        },
        "type": "object",
        "required": [
          "orders"
        ],
        "title": "OrdersListResponse"
      },
      "ProfileResponse": {
        "properties": {
          "user": {
            "$ref": "#/components/schemas/UserPublic"
          }
        },
        "type": "object",
        "required": [
          "user"
        ],
        "title": "ProfileResponse"
      },
      "RootResponse": {
        "properties": {
          "message": {
            "type": "string",
            "title": "Message"
          }
        },
        "type": "object",
        "required": [
          "message"
        ],
        "title": "RootResponse"
      },
      "SignupRequest": {
        "properties": {
          "username": {
            "type": "string",
            "maxLength": 60,
            "minLength": 3,
            "title": "Username",
            "examples": [
              "alice"
            ]
          },
          "email": {
            "type": "string",
            "title": "Email",
            "examples": [
              "alice@example.com"
            ]
          },
          "password": {
            "type": "string",
            "minLength": 6,
            "title": "Password",
            "examples": [
              "hunter22"
            ]
          }
        },
        "type": "object",
        "required": [
          "username",
          "email",
          "password"
        ],
        "title": "SignupRequest"
      },
      "SignupResponse": {
        "properties": {
          "success": {
            "type": "boolean",
            "title": "Success"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "user": {
            "$ref": "#/components/schemas/UserPublic"
          }
        },
        "type": "object",
        "required": [
          "success",
          "message",
          "user"
        ],
        "title": "SignupResponse"
      },
      "UserPublic": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "username": {
            "type": "string",
            "title": "Username"
          },
          "email": {
            "type": "string",
            "title": "Email",
            "default": ""
          },
          "first_name": {
            "type": "string",
            "title": "First Name",
            "default": ""
          },
          "last_name": {
            "type": "string",
            "title": "Last Name",
            "default": ""
          },
          "locked": {
            "type": "boolean",
            "title": "Locked",
            "default": false
          },
          "created_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Created At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "username"
        ],
        "title": "UserPublic"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "type": "http",
        "description": "Opaque token from POST /api/auth/login",
        "scheme": "bearer"
      }
    }
  },
  "tags": [
    {
      "name": "Public",
      "description": "No authentication required."
    },
    {
      "name": "Auth",
      "description": "Login and account registration."
    },
    {
      "name": "Protected",
      "description": "Requires `Authorization: Bearer <token>` from login."
    }
  ]
}