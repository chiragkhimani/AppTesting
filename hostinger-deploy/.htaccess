# QA Demo Store – Apache config for Hostinger shared hosting.
# Place this file at: public_html/.htaccess

Options -MultiViews
RewriteEngine On

# ---------------------------------------------------------------------------
# 1) Extensionless API
#    Maps /api/users        → /api/users.php
#         /api/auth/login   → /api/auth/login.php
#         /api/products?id=1→ /api/products.php?id=1   (query string preserved)
#
#    Conditions:
#      - Only paths that begin with /api/
#      - URI does NOT already end in .php (avoids /api/users.php → .php.php)
#      - The requested filename is not an actual file/dir (lets static .php
#        files still be served directly for backward-compatibility)
# ---------------------------------------------------------------------------
RewriteCond %{REQUEST_URI} ^/api/ [NC]
RewriteCond %{REQUEST_URI} !\.php$ [NC]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^api/(.+?)/?$ api/$1.php [L,QSA]

# Force HTTPS (optional – uncomment after SSL is active on Hostinger)
# RewriteCond %{HTTPS} off
# RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

# ---------------------------------------------------------------------------
# 2) Don't hand /api/* over to the React SPA
# ---------------------------------------------------------------------------
RewriteCond %{REQUEST_URI} ^/api/ [NC]
RewriteRule ^ - [L]

# ---------------------------------------------------------------------------
# 3) Serve real files / directories as-is
# ---------------------------------------------------------------------------
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# ---------------------------------------------------------------------------
# 4) Anything else → React's index.html (client-side router)
# ---------------------------------------------------------------------------
RewriteRule ^ index.html [L]

# Gzip for faster delivery
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json image/svg+xml
</IfModule>

# Cache static assets
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css                 "access plus 1 month"
    ExpiresByType application/javascript   "access plus 1 month"
    ExpiresByType image/png                "access plus 1 month"
    ExpiresByType image/jpeg               "access plus 1 month"
    ExpiresByType image/svg+xml            "access plus 1 month"
    ExpiresByType font/woff2               "access plus 1 year"
</IfModule>
