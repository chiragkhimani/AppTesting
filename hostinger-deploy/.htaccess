# QA Demo Store – Apache config for Hostinger shared hosting.
# Place this file at: public_html/playground/.htaccess

Options -MultiViews
RewriteEngine On
RewriteBase /playground/

# ---------------------------------------------------------------------------
# 1) Extensionless API
#    Maps /playground/api/users        → /playground/api/users.php
#         /playground/api/auth/login   → /playground/api/auth/login.php
#         /playground/api/products?id=1→ /playground/api/products.php?id=1
# ---------------------------------------------------------------------------
RewriteCond %{REQUEST_URI} ^/playground/api/ [NC]
RewriteCond %{REQUEST_URI} !\.php$ [NC]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^api/(.+?)/?$ api/$1.php [L,QSA]

# Force HTTPS (optional – uncomment after SSL is active on Hostinger)
# RewriteCond %{HTTPS} off
# RewriteRule ^(.*)$ https://%{HTTP_HOST}/playground/$1 [R=301,L]

# ---------------------------------------------------------------------------
# 2) Don't hand /playground/api/* or /playground/docs/* over to the React SPA
# ---------------------------------------------------------------------------
RewriteCond %{REQUEST_URI} ^/playground/api/ [NC]
RewriteRule ^ - [L]

RewriteRule ^docs$ /playground/docs/ [R=301,L]
RewriteRule ^docs/$ docs/index.html [L]
RewriteCond %{REQUEST_URI} ^/playground/docs/ [NC]
RewriteRule ^ - [L]

# ---------------------------------------------------------------------------
# 3) Serve real files / directories as-is
# ---------------------------------------------------------------------------
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# ---------------------------------------------------------------------------
# 4) Anything else → React's index.html (client-side router)
# ---------------------------------------------------------------------------
RewriteRule ^ index.html [L]

# Gzip for faster delivery
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json image/svg+xml
</IfModule>

# Cache static assets
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css                 "access plus 1 month"
    ExpiresByType application/javascript   "access plus 1 month"
    ExpiresByType image/png                "access plus 1 month"
    ExpiresByType image/jpeg               "access plus 1 month"
    ExpiresByType image/svg+xml            "access plus 1 month"
    ExpiresByType font/woff2               "access plus 1 year"
</IfModule>
