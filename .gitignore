# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# IDE and editors
.idea/
.vscode/
*.swp
*.swo
*~

# Local tooling (MongoDB binaries/data)
.tools/

# Emergent runtime markers (keep .emergent/emergent.yml tracked)
.emergent/markers/

# Dependencies
node_modules/
.pnp
.pnp.js
.yarn/install-state.gz
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
vendor/

# Testing / coverage
coverage/
.coverage
.coverage.*
htmlcov/
.pytest_cache/
.tox/
.nox/
test_reports/**
!test_reports/**/
!test_reports/**/.gitkeep

# Frontend (CRA / CRACO)
frontend/build/
.cache/

# Production builds
build/
dist/
*.tsbuildinfo

# Environment and secrets
.env
.env.*
*.env
!.env.example
!.env.*.example
*token.json*
*credentials.json*
credentials.json
*.pem
*.key
.credentials

# Logs and debug files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
dump.rdb

# System files
.DS_Store
Thumbs.db
Desktop.ini

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
*.egg
.eggs/
venv/
.venv/
env/
.mypy_cache/
.ruff_cache/
.dmypy.json
dmypy.json

# Archives and large assets
*.zip
*.tar.gz
*.tar
*.tgz
*.pack

# Deployment
.vercel
